# Optional. The shared gateway URL, its key and the built-in model ids are baked
# into `src/types.ts`, so a fresh clone builds and translates with no `.env`.
# Copy this file only to point a local build at a different gateway. Every VITE_*
# value is inlined into `dist/`.

VITE_AI_ENDPOINT=http://103.38.236.38:20128/v1
VITE_AI_API_KEY=sk-...

# Must be published on the gateway's Models list, else `model_not_found`.
VITE_AUTO_FREE_MODEL=auto-free
